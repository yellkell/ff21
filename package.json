{
  "name": "fire-fight-2",
  "version": "0.1.0",
  "description": "FIRE FIGHT 2 \u2014 the WebXR fireball-boxing sequel: Rave Raid folded in as a mode, a shared social club that launches everything, paintable mannequin fighters, and next-gen dark desert arenas. Built on the Immersive Web SDK.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "server": "node server/room.mjs",
    "server:ff": "node server/index.mjs",
    "server:pub": "node server/pub.mjs",
    "server:rave": "node server/rave.mjs",
    "server:bank": "node server/bank.mjs",
    "check:wrap": "node tools/wrap-check.mjs",
    "check:paint": "node tools/paint-wire-check.mjs",
    "check:grammar": "node tools/grammar-check.mjs",
    "check:delivery": "node tools/delivery-check.mjs",
    "check:gestures": "node tools/gesture-check.mjs",
    "check:pages": "node tools/pages-check.mjs",
    "check:stats-tracks": "node tools/stats-tracks-check.mjs",
    "check:desert": "node tools/desert-check.mjs",
    "check:cove": "node tools/cove-check.mjs",
    "check:rave": "node tools/rave-check.mjs",
    "check:lasers": "node tools/laser-check.mjs",
    "check:venue": "node tools/venue-check.mjs",
    "check:course": "node tools/course-check.mjs",
    "check:bot": "node tools/bot-check.mjs",
    "check:rules": "firebase emulators:exec --only firestore --project ff2-rules-check \"node tools/rules-check.mjs\"",
    "check:mirror": "node tools/mirror-check.mjs",
    "check:voidstep": "node tools/voidstep-check.mjs",
    "check:tv": "node tools/tv-check.mjs",
    "check:promo": "node tools/promo-check.mjs",
    "check:bank": "node tools/bank-check.mjs",
    "check:forge": "node tools/forge-check.mjs",
    "gear:gallery": "node tools/gear-gallery.mjs",
    "bot:check": "node bot/check.mjs && node bot/sim/smoke.mjs",
    "bot:train": "node bot/train/ppo.mjs",
    "bot:eval": "node bot/train/eval.mjs bot/models/current.json",
    "bot:probe": "node bot/live/host.mjs --probe overlord",
    "bot:host": "node bot/live/host.mjs",
    "bot:serve": "node bot/live/serve.mjs",
    "bot:report": "node bot/live/report.mjs",
    "bot:harvest": "node bot/train/harvest.mjs"
  },
  "dependencies": {
    "@iwsdk/core": "0.4.2",
    "firebase": "^12.14.0",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@iwsdk/vite-plugin-dev": "0.4.2",
    "@types/three": "0.184.0",
    "firebase-admin": "^14.3.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "ws": "^8.18.0"
  }
}
